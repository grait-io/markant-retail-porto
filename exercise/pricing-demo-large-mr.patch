@@ -0,0 +1,19 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { TierPricingService } from "../../src/tiers/TierPricingService.js";
+
+const article = { id: "T-1", basePriceCents: 1000 };
+
+test("no discount for small quantities", () => {
+  assert.equal(new TierPricingService().unitPriceCents(article, 5), 1000);
+});
+test("5 percent for 50 units", () => {
+  assert.equal(new TierPricingService().unitPriceCents(article, 50), 950);
+});
+test("12 percent for 500 units", () => {
+  assert.equal(new TierPricingService().unitPriceCents(article, 500), 880);
+});
+test("cache returns the same value", () => {
+  const service = new TierPricingService();
+  assert.equal(service.unitPriceCents(article, 50), service.unitPriceCents(article, 50));
+});
