@@ -0,0 +1,19 @@
+import { TierStrategyFactory } from "./TierStrategyFactory.js";
+import { LruCache } from "../infra/LruCache.js";
+import { pricingEvents } from "../infra/EventBus.js";
+
+export class TierPricingService {
+  constructor(factory = new TierStrategyFactory(), cache = new LruCache()) {
+    this.factory = factory; this.cache = cache;
+  }
+  unitPriceCents(article, quantity) {
+    const key = `${article.id}:${quantity}`;
+    const cached = this.cache.get(key);
+    if (cached !== undefined) return cached;
+    const price = this.factory.forQuantity(quantity).apply(article.basePriceCents, quantity);
+    this.cache.set(key, price);
+    pricingEvents.emit("price.calculated", { articleId: article.id, quantity, price });
+    return price;
+  }
+}
+export const tierPricingService = new TierPricingService();
diff --git a/src/tiers/TierStrategyFactory.js b/src/tiers/TierStrategyFactory.js
new file mode 100644
index 0000000..b3667cf
--- /dev/null
+++ b/src/tiers/TierStrategyFactory.js
@@ -0,0 +1,11 @@
+import { NoDiscountStrategy } from "./strategies/NoDiscountStrategy.js";
+import { PercentDiscountStrategy } from "./strategies/PercentDiscountStrategy.js";
+import { TierConfigLoader } from "./config/TierConfigLoader.js";
+
+export class TierStrategyFactory {
+  constructor(loader = new TierConfigLoader()) { this.tiers = loader.load(); }
+  forQuantity(quantity) {
+    const match = [...this.tiers].reverse().find((tier) => quantity > tier.minQuantity);
+    return match ? new PercentDiscountStrategy(match.discountPercent) : new NoDiscountStrategy();
+  }
+}
