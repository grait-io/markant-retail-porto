@@ -0,0 +1,14 @@
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { Logger } from "../../infra/Logger.js";
+
+export class TierConfigLoader {
+  constructor(path = fileURLToPath(new URL("./tiers.json", import.meta.url))) {
+    this.path = path;
+    this.logger = new Logger("TierConfigLoader");
+  }
+  load() {
+    this.logger.debug(`loading ${this.path}`);
+    return JSON.parse(readFileSync(this.path, "utf8")).tiers;
+  }
+}
